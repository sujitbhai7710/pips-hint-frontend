---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PuzzleCard from '../../components/svelte/PuzzleCard.svelte';
import { api, type PuzzleResponse } from '../../lib/api';

// Fetch a random puzzle
let puzzle: PuzzleResponse | null = null;
let puzzleError: string | null = null;

try {
  const result = await api.getUnlimited();
  // The unlimited endpoint returns a single puzzle response
  puzzle = result as any;
} catch (e: any) {
  puzzleError = e.message || 'Failed to load unlimited puzzle';
}
---

<BaseLayout title="Unlimited Pips - Endless Puzzle Practice | Pips Hint" description="Play unlimited Pips puzzles for endless practice. Get random puzzles with AI-powered hints and solutions.">
  <section class="py-16 xl:py-20">
    <div class="container mx-auto px-4 xl:px-6">
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-bold mb-2">
          <span class="gradient-text">Unlimited Pips</span>
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          Practice with random puzzles from our collection
        </p>
      </div>

      {puzzle ? (
        <div>
          <PuzzleCard client:load puzzle={puzzle} />

          <div class="max-w-4xl mx-auto mt-6 text-center">
            <button
              id="new-puzzle-btn"
              class="gradient-btn px-8 py-3"
            >
              New Random Puzzle
            </button>
          </div>
        </div>
      ) : (
        <div class="max-w-4xl mx-auto rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xl p-8 text-center">
          <svg class="w-16 h-16 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <h2 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">No Puzzle Available</h2>
          <p class="text-gray-500 dark:text-gray-400">{puzzleError || 'Could not load a random puzzle. Try again later.'}</p>
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    document.getElementById('new-puzzle-btn')?.addEventListener('click', function() {
      window.location.reload();
    });
  </script>
</BaseLayout>
