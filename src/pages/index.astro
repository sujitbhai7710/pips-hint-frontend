---
import BaseLayout from '../layouts/BaseLayout.astro';
import PuzzleCard from '../components/svelte/PuzzleCard.svelte';
import FAQAccordion from '../components/svelte/FAQAccordion.svelte';
import { api, getPuzzleForDate } from '../lib/api';

// Fetch today's puzzle at build time (SSG)
let puzzle = null;
let puzzleError = null;
let faqs = [];

try {
  puzzle = await getPuzzleForDate();
  if (puzzle?.explanation?.faqs) {
    faqs = puzzle.explanation.faqs;
  }
} catch (e) {
  puzzleError = e?.message || 'Failed to load puzzle';
}
---

<BaseLayout title="Pips Hint - Daily NYT Pips Puzzle Hints & Answers">
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 xl:py-20">
    <div class="absolute inset-0 bg-gradient-to-r from-primary-600/10 to-accent-600/10"></div>
    <div class="container mx-auto px-4 xl:px-6 relative">
      <div class="text-center mb-10 animate-fade-in-up">
        <h1 class="text-4xl lg:text-5xl font-bold mb-4">
          <span class="gradient-text">NYT Pips Hints & Answers</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Get daily hints, strategies, and solutions for the New York Times Pips puzzle. Updated every day with expert analysis.
        </p>
      </div>

      <!-- Puzzle Card -->
      <div class="animate-fade-in-up delay-200">
        {puzzle ? (
          <PuzzleCard client:load puzzle={puzzle} />
        ) : (
          <div class="max-w-4xl mx-auto rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xl p-8 text-center">
            <svg class="w-16 h-16 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M12 2a10 10 0 100 20 10 10 0 000-20z" />
            </svg>
            <h2 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">No Puzzle Available Yet</h2>
            <p class="text-gray-500 dark:text-gray-400">Today's puzzle hasn't been published yet. Check back soon or browse the archive!</p>
            <a href="/archive" class="inline-block mt-4 gradient-btn">Browse Archive</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- What is Pips Hint Section -->
  <section class="py-16 xl:py-20 bg-white dark:bg-gray-900/30">
    <div class="container mx-auto px-4 xl:px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          What is <span class="gradient-text">Pips Hint</span>?
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Your daily companion for solving the NYT Pips puzzle with expert hints, detailed strategies, and complete solutions for all difficulty levels.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3 xl:gap-6">
        <!-- Feature 1 -->
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-6 bg-white dark:bg-gray-800 shadow-sm card-hover">
          <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Daily Puzzle Hints</h3>
          <p class="text-gray-600 dark:text-gray-400">Get carefully crafted hints for every difficulty level — Easy, Medium, and Hard. Each hint guides you toward the solution without giving it away.</p>
        </div>

        <!-- Feature 2 -->
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-6 bg-white dark:bg-gray-800 shadow-sm card-hover">
          <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Expert Strategies</h3>
          <p class="text-gray-600 dark:text-gray-400">Learn solving techniques from experienced puzzle enthusiasts. Our AI-powered analysis breaks down each puzzle's unique challenges and patterns.</p>
        </div>

        <!-- Feature 3 -->
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-6 bg-white dark:bg-gray-800 shadow-sm card-hover">
          <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Complete Solutions</h3>
          <p class="text-gray-600 dark:text-gray-400">Stuck on a puzzle? Reveal the complete solution with step-by-step explanations. Understand why each domino goes where it does.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Play Section -->
  <section class="py-16 xl:py-20">
    <div class="container mx-auto px-4 xl:px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-12 text-center">
        How to Play <span class="gradient-text">Pips</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Rules -->
        <div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-6">Rules</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-600 dark:text-gray-400">Place dominoes on the grid so each domino covers exactly two adjacent cells.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-600 dark:text-gray-400">Every cell must be covered by exactly one domino — no gaps, no overlaps.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-600 dark:text-gray-400">Regions with a number must have their domino values sum to that number.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-gray-600 dark:text-gray-400">Satisfy all region constraints (sum, equals, unequal, less, greater) to solve the puzzle.</span>
            </li>
          </ul>
        </div>

        <!-- Region Conditions -->
        <div class="rounded-2xl bg-gradient-to-br from-primary-50 to-accent-400/10 dark:from-primary-900/20 dark:to-accent-700/10 p-6 border border-primary-200 dark:border-primary-800">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Region Conditions</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-lg bg-white dark:bg-gray-800 flex items-center justify-center font-bold text-primary-600 shadow-sm">=</span>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-100">Equals</strong> — All domino values in this region must be the same.</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-lg bg-white dark:bg-gray-800 flex items-center justify-center font-bold text-accent-600 dark:text-accent-400 shadow-sm">&ne;</span>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-100">Unequal</strong> — All domino values in this region must be different.</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-lg bg-white dark:bg-gray-800 flex items-center justify-center font-bold text-primary-600 shadow-sm">N</span>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-100">Sum</strong> — Domino values must add up to the given number N.</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-lg bg-white dark:bg-gray-800 flex items-center justify-center font-bold text-primary-600 shadow-sm">&lt;</span>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-100">Less Than</strong> — One group's sum is less than the other's.</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-lg bg-white dark:bg-gray-800 flex items-center justify-center font-bold text-primary-600 shadow-sm">&gt;</span>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-gray-100">Greater Than</strong> — One group's sum is greater than the other's.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Banner -->
  <section class="py-12 bg-gradient-to-r from-primary-600 to-accent-600 text-white">
    <div class="container mx-auto px-4 xl:px-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-3xl font-bold">Daily</p>
          <p class="text-blue-100 text-sm mt-1">Updates</p>
        </div>
        <div>
          <p class="text-3xl font-bold">3</p>
          <p class="text-blue-100 text-sm mt-1">Difficulty Levels</p>
        </div>
        <div>
          <p class="text-3xl font-bold">AI</p>
          <p class="text-blue-100 text-sm mt-1">Smart Hints</p>
        </div>
        <div>
          <p class="text-3xl font-bold">100%</p>
          <p class="text-blue-100 text-sm mt-1">Accurate</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  {faqs.length > 0 && (
    <section class="py-16 xl:py-20 bg-white dark:bg-gray-900/30">
      <div class="container mx-auto px-4 xl:px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">
          Frequently Asked <span class="gradient-text">Questions</span>
        </h2>
        <div class="max-w-3xl mx-auto">
          <FAQAccordion client:visible faqs={faqs} />
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="py-16 xl:py-20 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-950">
    <div class="container mx-auto px-4 xl:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        Ready to Master <span class="gradient-text">Pips</span>?
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-xl mx-auto mb-8">
        Start solving puzzles with expert hints and strategies. Never get stuck on a Pips puzzle again.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/today" class="gradient-btn px-8 py-3 text-base">Start Using Pips Hint</a>
        <a href="/pips/unlimited" class="px-8 py-3 text-base rounded-lg border-2 border-primary-600 dark:border-primary-400 text-primary-600 dark:text-primary-400 font-medium hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors">
          Play Unlimited
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
