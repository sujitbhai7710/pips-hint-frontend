---
import BaseLayout from '../layouts/BaseLayout.astro';
import PuzzleCard from '../components/svelte/PuzzleCard.svelte';
import DateNavigator from '../components/svelte/DateNavigator.svelte';
import { api, getPuzzleForDate, getTodayString } from '../lib/api';

const today = getTodayString();

// Try to get today's puzzle, fall back to yesterday
let puzzle = null;
let puzzleError = null;

try {
  puzzle = await getPuzzleForDate();
} catch (e) {
  puzzleError = e?.message || "Failed to load today's puzzle";
}

if (!puzzle) {
  try {
    puzzle = await api.getYesterday();
  } catch {
    puzzleError = "Today's puzzle hasn't been published yet. Check back soon!";
  }
}

const displayDate = puzzle?.printDate || today;
const tips = puzzle?.explanation?.tips || null;
const learned = puzzle?.explanation?.learned || null;
---

<BaseLayout title="Today's NYT Pips Hints & Answers - Pips Hint" description="Get today's NYT Pips puzzle hints and answers. Expert analysis for Easy, Medium, and Hard difficulties.">
  <section class="py-16 xl:py-20">
    <div class="container mx-auto px-4 xl:px-6">
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-bold mb-2">
          <span class="gradient-text">Today's Pips Hints</span>
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          {displayDate}
        </p>
      </div>

      <!-- Date Navigator -->
      <div class="flex justify-center mb-8">
        <DateNavigator client:load currentDate={displayDate} onDateChange={(date) => window.location.href = `/archive?date=${date}`} />
      </div>

      <!-- Puzzle Card -->
      {puzzle ? (
        <PuzzleCard client:load puzzle={puzzle} error={puzzleError} />
      ) : (
        <div class="max-w-4xl mx-auto rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xl p-8 text-center">
          <svg class="w-16 h-16 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h2 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">Today's Puzzle Not Available Yet</h2>
          <p class="text-gray-500 dark:text-gray-400 mb-4">{puzzleError || "The puzzle for today hasn't been published yet. Check back later!"}</p>
          <div class="flex gap-3 justify-center">
            <a href="/archive" class="gradient-btn">Browse Archive</a>
            <a href="/pips/unlimited" class="px-6 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              Play Unlimited
            </a>
          </div>
        </div>
      )}

      <!-- Tips Section -->
      {tips && (
        <div class="max-w-4xl mx-auto mt-8">
          <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <h3 class="text-lg font-bold gradient-text mb-3">Solving Tips</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{tips}</p>
          </div>
        </div>
      )}

      <!-- What I Learned Section -->
      {learned && (
        <div class="max-w-4xl mx-auto mt-4">
          <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6">
            <h3 class="text-lg font-bold gradient-text mb-3">What We Learned</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{learned}</p>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
