---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsDisplay from '../components/svelte/StatsDisplay.svelte';
import { api, type StatsResponse } from '../lib/api';

let stats: StatsResponse | null = null;

try {
  stats = await api.getStats();
} catch (e) {
  console.error('Failed to fetch stats:', e);
}
---

<BaseLayout title="Pips Puzzle Statistics & Analytics | Pips Hint" description="Explore statistics and analytics about NYT Pips puzzles. See puzzle counts, constructor rankings, and region distributions.">
  <section class="py-16 xl:py-20">
    <div class="container mx-auto px-4 xl:px-6">
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold mb-2">
          <span class="gradient-text">Puzzle Statistics</span>
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          Analytics and insights about the NYT Pips puzzle collection
        </p>
      </div>

      {stats ? (
        <StatsDisplay client:load stats={stats} />
      ) : (
        <div class="text-center py-16">
          <svg class="animate-spin h-8 w-8 text-primary-600 mx-auto mb-4" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
          </svg>
          <p class="text-gray-500 dark:text-gray-400">Loading statistics...</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
